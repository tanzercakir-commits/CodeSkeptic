# Retained receipts are checksum-bound artifacts. Keep their committed bytes
# identical on every host; line-ending conversion would invalidate evidence.
* text=auto eol=lf
docs/PLAN.md text eol=lf
docs/TODO.md text eol=lf
docs/PROGRESS.md text eol=lf
*.sh text eol=lf
scripts/upstream_candidate_receipts/** -text
docs/evidence/phase10/fuzz/** -text
docs/evidence/phase10/fuzz/** -diff
fuzz/corpus/** -text
third_party/*.tar.gz -text
third_party/*.tar.gz -diff
docs/evidence/phase10/sanitizers/** -text
docs/evidence/phase10/sanitizers/** -diff
scripts/run_stress_matrix.py text eol=lf
tests/StressMatrixTest.py text eol=lf
tests/stress_corpus/** text eol=lf
docs/evidence/phase10/stress/** -text
docs/evidence/phase10/stress/** -diff
docs/evidence/phase10/quality/** -text
docs/evidence/phase10/quality/** -diff
