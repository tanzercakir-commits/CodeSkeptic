  "rules": {
    "alloc-size-overflow": {
      "tier_at_selection": "experimental",
      "cwes": [
        131
      ],
      "subset": "Declared untrusted integer origins feeding native allocation sizes; constant uint64 arithmetic and exact checked-add status/output identity.",
      "limitations": [
        "Unknown runtime addends and opaque mutations are not safe negatives.",
        "No claim of complete taint tracking or all allocators."
      ]
    },
    "bounds": {
      "tier_at_selection": "experimental",
      "cwes": [
        120,
        125,
        787,
        823
      ],
      "subset": "Known object capacities, native copy source/destination byte sizes and representable constant offsets.",
      "limitations": [
        "Unknown extents/offsets, flexible tails and noncanonical signatures are not covered.",
        "One-past formation alone is not a read/write finding."
      ]
    },
    "div-by-zero": {
      "tier_at_selection": "supported",
      "cwes": [
        369
      ],
      "subset": "Proven zero values and supported local/interprocedural propagation.",
      "limitations": [
        "Unknown parameters and unresolved function-pointer flow are not complete zero/nonzero proofs."
      ]
    },
    "double-free": {
      "tier_at_selection": "supported",
      "cwes": [
        415,
        675
      ],
      "subset": "Repeated release of a tracked allocation/resource.",
      "limitations": [
        "Opaque alias and unmodeled custom release behavior are not universally resolved."
      ]
    },
    "int-overflow": {
      "tier_at_selection": "supported",
      "cwes": [
        190,
        191,
        681
      ],
      "subset": "Modeled signed arithmetic including signed64 subtraction and destination-range evidence.",
      "limitations": [
        "Unknown operands, unsigned wrap and arbitrary explicit casts are not all diagnosed."
      ]
    },
    "memory-leak": {
      "tier_at_selection": "supported",
      "cwes": [
        401,
        772,
        775
      ],
      "subset": "Local pointer acquisitions, supported releases and modeled ownership paths.",
      "limitations": [
        "General global/cross-TU alias escape analysis is not complete; inherited known misses remain in Juliet."
      ]
    },
    "null-deref": {
      "tier_at_selection": "supported",
      "cwes": [
        476
      ],
      "subset": "Proven null and modeled maybe-null values at dereferences.",
      "limitations": [
        "Unknown pointer and caller states are not universal nonnull proofs."
      ]
    },
    "resource-leak": {
      "tier_at_selection": "supported",
      "cwes": [
        401,
        772,
        775
      ],
      "subset": "Native descriptor/stream acquisitions, pipe outputs, accept return ownership, exact local RAII and success-conditional fdopendir.",
      "limitations": [
        "RAII is restricted to proven one-field owner bodies; arbitrary constructors and destructors are not ownership proofs.",
        "Unavailable or indirect transfer destinations and unsupported aliases conservatively retain obligations."
      ]
    },
    "sign-conversion": {
      "tier_at_selection": "experimental",
      "cwes": [
        195,
        681
      ],
      "subset": "Declared signed input conversion plus proven implicit narrowing reaching native memory sinks.",
      "limitations": [
        "Explicit narrowing, unknown ranges, enum/volatile/dependent storage and non-memory consumers are not this subset.",
        "An allocation-only sink is not a general sign-conversion defect claim."
      ]
    },
    "uninit-ptr": {
      "tier_at_selection": "experimental",
      "cwes": [
        824
      ],
      "subset": "Automatic pointer initialization before dereference.",
      "limitations": [
        "Unknown pointer provenance and general interprocedural aliasing are not universal safety proofs."
      ]
    },
    "uninit-scalar": {
      "tier_at_selection": "experimental",
      "cwes": [
        457
      ],
      "subset": "Automatic integer/bool reads with straight-line and supported CFG joins.",
      "limitations": [
        "Float, array, aggregate, enum, volatile storage and unsupported sequencing/EH remain outside the subset.",
        "Unknown external writes are not initialization or defect proofs."
      ]
    },
    "use-after-free": {
      "tier_at_selection": "supported",
      "cwes": [
        416,
        672
      ],
      "subset": "Uses after a tracked allocation/resource release.",
      "limitations": [
        "General concurrent and opaque interprocedural lifetimes are outside the guarantee."
      ]
    }
  },
  "excluded_capabilities": {
    "assumption": "Opt-in inferred assumptions have no CWE family; full existing assumption tests remain mandatory.",
    "contract": "Contract processing has no CWE family; existing contract and real-world gates are preserved.",
