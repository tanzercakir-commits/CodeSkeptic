// id, tier, default-enabled, quality-gated, blocks-verdict, evidence
//
// This file is the single machine-readable rule scope registry. Keep each
// entry on one line: scripts/check_capabilities_sync.py also reads it to
// prove README.md and docs/capabilities.md publish the same contract.
CODESKEPTIC_RULE_CAPABILITY("uninit-ptr", Experimental, true, false, false, "per-rule precision sample pending")
CODESKEPTIC_RULE_CAPABILITY("uninit-scalar", Experimental, true, false, false, "straight-line automatic integer/bool subset; independent precision sample pending")
CODESKEPTIC_RULE_CAPABILITY("memory-leak", Supported, true, true, true, "Juliet 0.860 precision (80 TP / 13 FP); Phase 3 gate >= 0.85")
CODESKEPTIC_RULE_CAPABILITY("double-free", Supported, true, true, true, "Juliet 1.000 precision (101 TP / 0 FP)")
CODESKEPTIC_RULE_CAPABILITY("use-after-free", Supported, true, true, true, "Juliet 1.000 precision (212 TP / 0 FP)")
CODESKEPTIC_RULE_CAPABILITY("resource-leak", Supported, true, true, true, "pinned libarchive v3.8.9 mutation sample 1.000 precision (3 TP / 0 FP); Phase 5 gate >= 0.90")
CODESKEPTIC_RULE_CAPABILITY("div-by-zero", Supported, true, true, true, "Juliet 1.000 precision (43 TP / 0 FP)")
CODESKEPTIC_RULE_CAPABILITY("null-deref", Supported, true, true, true, "Juliet 1.000 precision (140 TP / 0 FP)")
CODESKEPTIC_RULE_CAPABILITY("bounds", Experimental, true, false, false, "per-rule precision sample pending")
CODESKEPTIC_RULE_CAPABILITY("int-overflow", Supported, true, true, true, "Juliet 1.000 precision (23 TP / 0 FP)")
CODESKEPTIC_RULE_CAPABILITY("sign-conversion", Experimental, true, false, false, "per-rule precision sample pending")
CODESKEPTIC_RULE_CAPABILITY("alloc-size-overflow", Experimental, true, false, false, "per-rule precision sample pending")
CODESKEPTIC_RULE_CAPABILITY("assumption", Experimental, false, false, false, "explicit --assumptions report-only mode")
CODESKEPTIC_RULE_CAPABILITY("contract", Experimental, true, false, false, "contract corpus measured; independent precision sample pending")
CODESKEPTIC_RULE_CAPABILITY("policy", Experimental, true, false, false, "policy corpus measured; independent precision sample pending")
